MODEL:
!Se maximiza el margen, ver tabla 1;
MAX = 5.39*AMERICANO + 7.75*CAPUCHINO + 8.46*LATTE + 6.84*CAFELECHE + 9.10*MOCACCINO;

!Declaramos las restricciones, ver tabla 2 y 3;
[CAFE] 18*AMERICANO + 18*CAPUCHINO + 18*LATTE + 14*CAFELECHE + 18*MOCACCINO <= 2000;
[LECHE] 150*CAPUCHINO + 220*LATTE + 180*CAFELECHE + 160*MOCACCINO <= 9600;
[AZUCAR] 5*AMERICANO + 6*CAPUCHINO + 6*LATTE + 8*CAFELECHE + 10*MOCACCINO <= 700;
[CHOCOLATE] 20*MOCACCINO <= 1500;
[TIEMPO] 2*AMERICANO + 3*CAPUCHINO + 3*LATTE + 2.5*CAFELECHE + 4*MOCACCINO <= 960;

@BND(10, AMERICANO, 45);
@BND(12, CAPUCHINO, 40);
@BND(12, LATTE, 35);
@BND(8, CAFELECHE, 25);
@BND(5, MOCACCINO, 20);
END